# Vorlage. Kopieren nach secrets.yaml und ausfuellen.
#   cp secrets.yaml.example secrets.yaml
# secrets.yaml steht in .gitignore und wird nie committet.

wifi_ssid: "MeinWLAN"
wifi_password: "meinWlanPasswort"

# Fallback-Hotspot, falls das WLAN nicht erreichbar ist
ap_password: "assistfallback"

# 32-Byte-Base64-Key fuer die verschluesselte HA-API.
# Erzeugen mit:  openssl rand -base64 32
api_encryption_key: "HIER_BASE64_KEY_EINSETZEN"

# Passwort fuer OTA-Updates
ota_password: "HIER_OTA_PASSWORT_EINSETZEN"
